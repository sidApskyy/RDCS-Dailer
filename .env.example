# =============================================================================
# RDCS Dialer Platform — Environment Variables
# =============================================================================
# Copy this file to .env and replace all placeholder values.
# In production, ALL secrets must be explicitly set — no insecure defaults.
# The API will fail fast if required secrets are missing or weak in production.
# =============================================================================

# Application
NODE_ENV=development
API_PORT=3001
LOG_LEVEL=info

# Web client
WEB_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL
POSTGRES_USER=rdcs
POSTGRES_PASSWORD=rdcs
POSTGRES_DB=rdcs
DATABASE_URL=postgresql://rdcs:rdcs@localhost:5432/rdcs?schema=public

# Redis
REDIS_PASSWORD=rdcs
REDIS_URL=redis://:rdcs@localhost:6379/0

# JWT — minimum 32 characters; use strong random secrets in production
JWT_SECRET=replace-with-a-development-only-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-development-only-secret-min-32-chars
JWT_EXPIRES_IN=1d
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MinIO (object storage for recordings)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123456
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=rdcs-recordings
