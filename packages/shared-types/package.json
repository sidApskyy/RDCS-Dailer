{
  "name": "@rdcs/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types and DTOs across RDCS apps",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts"
  },
  "devDependencies": {
    "@rdcs/tsconfig": "workspace:*",
    "eslint": "^8.57.0",
    "typescript": "^5.7.0"
  }
}
