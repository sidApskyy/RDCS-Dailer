# Application
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
SOCKET_PORT=3002

# Database
POSTGRES_USER=rdcs
POSTGRES_PASSWORD=rdcs
POSTGRES_DB=rdcs
DATABASE_URL=postgresql://rdcs:rdcs@postgres:5432/rdcs?schema=public

# Redis
REDIS_PASSWORD=rdcs
REDIS_URL=redis://:rdcs@redis:6379/0

# Object Storage
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123456
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=rdcs
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123456

# Authentication
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-too
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Telephony (local Asterisk/ViciDial integration later)
TELEPHONY_ADAPTER=mock
ASTERISK_AMI_HOST=localhost
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=admin
ASTERISK_AMI_SECRET=change-me

# Monitoring / Logging
SENTRY_DSN=
LOG_LEVEL=info
