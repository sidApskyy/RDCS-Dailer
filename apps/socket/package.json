{
  "name": "@rdcs/socket",
  "version": "0.1.0",
  "private": true,
  "description": "RDCS Socket.IO real-time gateway",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@rdcs/shared-types": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^5.4.0",
    "socket.io": "^4.8.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@rdcs/eslint-config": "workspace:*",
    "@rdcs/tsconfig": "workspace:*",
    "eslint": "^8.57.0",
    "@types/node": "^20.17.0",
    "@types/winston": "^2.4.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.0"
  }
}
