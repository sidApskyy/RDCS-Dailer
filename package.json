{
  "name": "rdcs-dialer-platform",
  "version": "0.1.0",
  "private": true,
  "description": "RDCS In-House Dialer Platform - monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.17.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "db:migrate:dev": "dotenv -e .env -- pnpm --filter @rdcs/database db:migrate:dev",
    "db:generate": "pnpm --filter @rdcs/database db:generate",
    "db:seed": "dotenv -e .env -- pnpm --filter @rdcs/database db:seed",
    "dev:infra": "docker compose -f docker/docker-compose.base.yml -f docker/docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker/docker-compose.base.yml -f docker/docker-compose.dev.yml down",
    "prepare": "husky install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.17.0",
    "dotenv-cli": "^8.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
